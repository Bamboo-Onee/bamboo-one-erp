# ==============================================================================
# AMBIENTE & CONFIGURAÇÕES GERAIS
# ==============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO

# ==============================================================================
# BANCO DE DADOS POSTGRESQL (ASSÍNCRONO VIA ASYNCPG)
# ==============================================================================
POSTGRES_DB=crm_logistico_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass_2026
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres_secure_pass_2026@localhost:5432/crm_logistico_db

# ==============================================================================
# SEGURANÇA, AUTENTICAÇÃO E JWT
# ==============================================================================
# Gere uma chave de 64 caracteres em produção: openssl rand -hex 32
SECRET_KEY=bamboo_enterprise_hyper_secure_jwt_secret_key_2026_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==============================================================================
# CORS & PORTAS
# ==============================================================================
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==============================================================================
# INTELIGÊNCIA ARTIFICIAL (TOOL CALLING)
# ==============================================================================
OPENAI_API_KEY=
GEMINI_API_KEY=
